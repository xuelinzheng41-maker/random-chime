{
  "name": "random-chime",
  "productName": "随机提示音",
  "version": "2.1.0",
  "description": "Anew (日新) · 融合神经科学随机提示音专注舱与 AI 助手的全能待办效率工作台",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable",
    "build:dir": "electron-builder --win dir"
  },
  "build": {
    "appId": "com.vibecoding.random-chime",
    "productName": "随机提示音",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "Anew-日新-${version}.exe"
    },
    "npmRebuild": false
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "author": "Random Chime"
}
